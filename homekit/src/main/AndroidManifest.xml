<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Despertar la pantalla cuando Casa manda "encender". -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Ver las apps con icono de TV para ofrecerlas como entradas. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <application>
        <!-- Pantalla de emparejamiento (código, QR, controladores). La abre el Centro de control. -->
        <activity
            android:name="live.hogar.homekit.HomeKitActivity"
            android:exported="false"
            android:label="HomeKit"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode" />
    </application>
</manifest>
